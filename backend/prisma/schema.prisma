datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}





model Institution {
  id          String          @id @default(uuid())
  name        String
  type        String @default("SCHOOL")
  code        String          @unique
  settings    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  branches      Branch[]
  users         User[]
  classes       Class[]
  feeStructures FeeStructure[]
  exams         Exam[]
  announcements Announcement[]

  @@map("institutions")
}

model Branch {
  id            String   @id @default(uuid())
  institutionId String   @map("institution_id")
  name          String
  address       String?
  contactInfo   String?  @map("contact_info")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  users       User[]
  classes     Class[]

  @@map("branches")
}

model User {
  id                 String   @id @default(uuid())
  institutionId      String   @map("institution_id")
  branchId           String?  @map("branch_id")
  email              String   @unique
  phone              String?  @unique
  passwordHash       String   @map("password_hash")
  role               String     @default("STUDENT")
  isActive           Boolean  @default(true) @map("is_active")
  otpSecret          String?  @map("otp_secret")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  branch      Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)

  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  parentProfile  ParentProfile?

  sentMessages     Message[]      @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")
  announcements    Announcement[] @relation("CreatedAnnouncements")

  @@map("users")
}

model StudentProfile {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  admissionNumber  String   @unique @map("admission_number")
  rollNumber       String?  @map("roll_number")
  classId          String?  @map("class_id")
  guardianId       String?  @map("guardian_id")
  otPasswordTemp   String?  @map("ot_password_temp")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  class    Class?         @relation(fields: [classId], references: [id], onDelete: SetNull)
  guardian ParentProfile? @relation(fields: [guardianId], references: [id], onDelete: SetNull)

  attendance Attendance[]
  invoices   Invoice[]
  grades     Grade[]

  @@map("student_profiles")
}

model TeacherProfile {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  employeeId     String   @unique @map("employee_id")
  qualification  String?
  specialization String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  timetables Timetable[]

  @@map("teacher_profiles")
}

model ParentProfile {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  occupation String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  students StudentProfile[]

  @@map("parent_profiles")
}

model Class {
  id            String   @id @default(uuid())
  institutionId String   @map("institution_id")
  branchId      String   @map("branch_id")
  name          String
  section       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  branch      Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  students    StudentProfile[]
  attendance  Attendance[]
  timetables  Timetable[]

  @@map("classes")
}

model Attendance {
  id            String           @id @default(uuid())
  studentId     String           @map("student_id")
  classId       String           @map("class_id")
  date          DateTime          
  status        String @default("PRESENT")
  subject       String?
  remarks       String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class          @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, date, subject])
  @@map("attendance")
}

model FeeStructure {
  id            String   @id @default(uuid())
  institutionId String   @map("institution_id")
  name          String
  amount        Float
  dueDate       DateTime @map("due_date")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  invoices    Invoice[]

  @@map("fee_structures")
}

model Invoice {
  id             String    @id @default(uuid())
  studentId      String    @map("student_id")
  feeStructureId String    @map("fee_structure_id")
  amount         Float
  status         String @default("PENDING")
  paidAt         DateTime? @map("paid_at")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure   @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model Exam {
  id            String   @id @default(uuid())
  institutionId String   @map("institution_id")
  title         String
  subject       String
  date          DateTime
  totalMarks    Float    @map("total_marks")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  grades      Grade[]

  @@map("exams")
}

model Grade {
  id        String   @id @default(uuid())
  examId    String   @map("exam_id")
  studentId String   @map("student_id")
  marks     Float
  remarks   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exam    Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@map("grades")
}

model Timetable {
  id        String   @id @default(uuid())
  classId   String   @map("class_id")
  teacherId String   @map("teacher_id")
  dayOfWeek Int      @map("day_of_week") // 1 = Monday, 7 = Sunday
  startTime String   @map("start_time") // HH:mm
  endTime   String   @map("end_time") // HH:mm
  subject   String
  room      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class   Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@map("timetables")
}

model Announcement {
  id            String   @id @default(uuid())
  institutionId String   @map("institution_id")
  creatorId     String   @map("creator_id")
  title         String
  content       String
  targetRole    String?    @map("target_role")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  creator     User        @relation("CreatedAnnouncements", fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("announcements")
}

model Message {
  id         String   @id @default(uuid())
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("messages")
}
