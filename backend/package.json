{
  "name": "school-coaching-backend",
  "version": "1.0.0",
  "description": "Backend API for School & Coaching Management System",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx src/prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "@prisma/extension-accelerate": "^0.3.0",
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "express-rate-limit": "^7.1.0",
    "cookie-parser": "^1.4.6",
    "jose": "^5.1.0",
    "bcryptjs": "^2.4.3",
    "zod": "^3.22.4",
    "swagger-ui-express": "^5.0.0",
    "csv-parser": "^3.0.0",
    "qrcode": "^1.5.3",
    "pdfkit": "^0.14.0",
    "nodemailer": "^6.9.10",
    "ws": "^8.16.0",
    "uuid": "^9.0.0",
    "dotenv": "^16.4.5",
    "winston": "^3.12.0",
    "prisma": "^5.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/cookie-parser": "^1.4.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^6.4.15",
    "@types/uuid": "^9.0.7",
    "@types/node": "^20.11.30",
    "tsx": "^4.7.1",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "prettier": "^3.2.0",
    "supertest": "^6.3.3",
    "@types/supertest": "^6.0.0"
  }
}
