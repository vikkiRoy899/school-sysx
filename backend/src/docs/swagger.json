{
  "openapi": "3.0.0",
  "info": {
    "title": "School & Coaching Management System API",
    "version": "1.0.0",
    "description": "API documentation for School & Coaching Management System"
  },
  "servers": [
    {
      "url": "http://localhost:4000/api/v1"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Login user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Successful login" }
        }
      }
    },
    "/students": {
      "get": {
        "summary": "Get all students",
        "responses": {
          "200": { "description": "List of students" }
        }
      }
    },
    "/fees/analytics": {
      "get": {
        "summary": "Get fee analytics",
        "responses": {
          "200": { "description": "Fee revenue analytics" }
        }
      }
    },
    "/exams": {
      "get": {
        "summary": "Get exams",
        "responses": {
          "200": { "description": "List of exams" }
        }
      }
    }
  }
}
