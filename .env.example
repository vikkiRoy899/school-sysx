# ---------------------------------------------------------------------------
# School & Coaching Management System — example environment file
# Copy to .env (backend) and adjust. Never commit real secrets.
# Requires Node.js 22 LTS or 24 LTS.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000

# Database — SQLite (default, zero-install)
# The path is resolved relative to backend/prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# PostgreSQL alternative (swap the provider in prisma/schema.prisma to "postgresql")
# DATABASE_URL="postgresql://user:password@localhost:5432/school_sys?schema=public"

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h

# CORS — comma separated list of allowed origins, or * for local development
CORS_ORIGIN=http://localhost:3000

# Frontends
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
